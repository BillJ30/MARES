# Copy this file to .env for local runs. Never commit .env.
# In GitHub, add the same values under Settings > Secrets and variables > Actions.

# Postgres connection string. On Supabase use the "Session pooler" string
# from the Connect button (the direct connection is IPv6 only).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# The SEC asks every automated client to identify itself with a name and email.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional. Free key from https://finnhub.io (leave blank to skip Finnhub).
FINNHUB_API_KEY=
